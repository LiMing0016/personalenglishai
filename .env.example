# ============================================
# 环境变量配置模板
# ============================================
# 使用方式：
# 1. 复制此文件为 .env：cp .env.example .env
# 2. 填写真实的配置值
# 3. 确保 .env 文件已添加到 .gitignore（不要提交到 Git）
# ============================================

# ACR 配置（用于 docker-compose.yml）
ACR_REGISTRY=registry.cn-hangzhou.aliyuncs.com
ACR_NAMESPACE=your-namespace

# Spring Profile
SPRING_PROFILES_ACTIVE=prod

# ============================================
# 数据库配置（方案 A：使用外部 RDS/MySQL）
# ============================================
# 方式 1：使用 Spring Boot 标准环境变量
SPRING_DATASOURCE_URL=jdbc:mysql://your-rds-endpoint:3306/personal_english_ai?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your-secure-password

# 方式 2：使用项目自定义环境变量（兼容现有配置）
DB_HOST=your-rds-endpoint
DB_PORT=3306
DB_NAME=personal_english_ai
DB_USER=root
DB_PASSWORD=your-secure-password

# ============================================
# 数据库配置（方案 B：使用 MySQL 容器）
# ============================================
# 如果使用 docker-compose.yml 中的 MySQL 容器，取消下面的注释
# MYSQL_ROOT_PASSWORD=your-secure-root-password
# MYSQL_DATABASE=personal_english_ai
# MYSQL_USER=appuser
# MYSQL_PASSWORD=your-secure-app-password
# DB_HOST=mysql
# DB_PORT=3306
# DB_NAME=personal_english_ai
# DB_USER=root
# DB_PASSWORD=your-secure-root-password

# ============================================
# JWT 配置
# ============================================
# 注意：JWT_SECRET 必须至少 32 字节长，建议使用随机字符串生成器
JWT_SECRET=your-jwt-secret-must-be-at-least-32-bytes-long-for-security
JWT_ACCESS_TOKEN_SECONDS=1800
JWT_REFRESH_TOKEN_SECONDS=259200

# ============================================
# 邮箱验证邮件 SMTP 配置
# ============================================
# APP_BASE_URL 是前端公开访问地址，用于生成邮箱验证/重置密码链接。
# 本地 start-local.bat 默认前端端口是 3300；生产环境必须改为 HTTPS 正式域名。
APP_BASE_URL=https://www.personalenglishai.com
MAIL_ENABLED=false

# 方案 A：阿里云邮件推送 DirectMail（推荐当前配置）
MAIL_HOST=smtpdm.aliyun.com
MAIL_PORT=465
MAIL_USERNAME=your-directmail-smtp-account
MAIL_PASSWORD=your-directmail-smtp-password
MAIL_FROM=noreply@personalenglishai.com
MAIL_SSL_ENABLE=true
MAIL_STARTTLS_ENABLE=false

# 方案 B：阿里邮箱/企业邮箱 SMTP（如使用普通邮箱账号发信，改用这一组）
# MAIL_HOST=smtp.qiye.aliyun.com
# MAIL_PORT=465
# MAIL_USERNAME=noreply@personalenglishai.com
# MAIL_PASSWORD=your-alibaba-mail-client-password
# MAIL_FROM=noreply@personalenglishai.com
# MAIL_SSL_ENABLE=true
# MAIL_STARTTLS_ENABLE=false

# Cookie secure flag：本地 HTTP 用 false；生产 HTTPS 必须为 true。
COOKIE_SECURE=true

# ============================================
# AI Provider（写作页会话级模型切换）
# ============================================
# 当前系统支持 openai / kimi / qwen。
# 如果前端请求没有显式传 aiProvider，后端会回退到 AI_PROVIDER_ACTIVE。
AI_PROVIDER_ACTIVE=openai

# OpenAI（OpenAI-compatible）
OPENAI_API_KEY=
AI_PROVIDER_OPENAI_API_KEY=
AI_PROVIDER_OPENAI_BASE_URL=https://api.openai.com
AI_PROVIDER_OPENAI_MODEL=gpt-4o

# 学习助手 Python Orchestrator
AI_ASSISTANT_MODEL=gpt-5.4-mini
AI_ASSISTANT_SESSION_DB_PATH=./python/ai_orchestrator/data/assistant_sessions.db
AI_ORCHESTRATOR_BASE_URL=http://127.0.0.1:8091
VITE_ASSISTANT_API_BASE_URL=http://127.0.0.1:8011

# Python Agents SDK Prompt 来源：local / hybrid / remote。
# local 为默认值，始终使用仓库内 Markdown prompt。
# hybrid 会在配置了 OpenAI Prompt ID 且 base URL 指向 api.openai.com 时使用远程 Prompt，否则回退本地。
# remote 要求每个被创建的 agent 都配置远程 Prompt，缺失时直接报错。
AI_ASSISTANT_PROMPT_SOURCE=local
AI_ASSISTANT_REMOTE_PROMPT_STRICT=false

# OpenAI 远程 Prompt ID。生产建议同时固定 VERSION，避免 Dashboard 更新后行为静默变化。
AI_PROMPT_ROUTER_ID=
AI_PROMPT_ROUTER_VERSION=
AI_PROMPT_ROUTE_DECISION_ID=
AI_PROMPT_ROUTE_DECISION_VERSION=

# Langfuse tracing for Python OpenAI Agents SDK orchestrator.
# 默认关闭；打开后需要三项都填写，LANGFUSE_BASE_URL 可换成自托管地址或区域地址。
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Kimi（Moonshot OpenAI-compatible）
AI_PROVIDER_KIMI_API_KEY=
AI_PROVIDER_KIMI_BASE_URL=https://api.moonshot.cn/v1
AI_PROVIDER_KIMI_MODEL=kimi-k2.5

# 千问（DashScope OpenAI-compatible）
AI_PROVIDER_QWEN_API_KEY=
AI_PROVIDER_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
AI_PROVIDER_QWEN_MODEL=qwen-plus

# ============================================
# OCR Provider（扫描版 PDF / 图片文档识别）
# ============================================
# tesseract：默认本地 OCR fallback。
# paddle：使用 PaddleOCR HTTP 服务，适合扫描版 PDF 和图片教材。
APP_OCR_PROVIDER=paddle
APP_OCR_PADDLE_ENABLED=true
APP_OCR_PADDLE_BASE_URL=http://paddle-ocr:8090
APP_OCR_PADDLE_ENDPOINT=/ocr/pdf
APP_OCR_PADDLE_LANGUAGE=ch,eng
APP_OCR_PADDLE_TIMEOUT_MS=120000
APP_OCR_PADDLE_PARSE_MODE=high_quality
APP_OCR_PADDLE_MAX_PAGES=500
APP_OCR_PADDLE_DPI=220
APP_OCR_PADDLE_ENABLE_LAYOUT=true
APP_OCR_PADDLE_ENABLE_TABLE=true
APP_OCR_PADDLE_ENABLE_FORMULA=false
APP_OCR_PADDLE_ENABLE_ORIENTATION=true
APP_OCR_PADDLE_ENABLE_UNWARPING=true
PADDLE_OCR_PORT=8090
PADDLE_OCR_ENABLE_FORMULA=false
PADDLE_OCR_CPU_THREADS=4

# ============================================
# Resend API Key（预留，未配置不影响启动）
# ============================================
RESEND_API_KEY=
