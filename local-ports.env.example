# Copy this file to local-ports.env and adjust per local project folder.
# local-ports.env is ignored by Git.
#
# Default ports are derived as:
#   BACKEND_PORT = BACKEND_BASE_PORT + PORT_OFFSET
#   WEB_PORT     = WEB_BASE_PORT + PORT_OFFSET
#   PYTHON_PORT  = PYTHON_BASE_PORT + PORT_OFFSET
#   DOCS_PORT    = DOCS_BASE_PORT + PORT_OFFSET
#   NGINX_PORT   = NGINX_BASE_PORT + PORT_OFFSET
#
# For another local agent/worktree, keep the base ports and change PORT_OFFSET,
# for example PORT_OFFSET=100.

PORT_OFFSET=0

BACKEND_BASE_PORT=18080
WEB_BASE_PORT=3300
PYTHON_BASE_PORT=8011
DOCS_BASE_PORT=5174
NGINX_BASE_PORT=8080

PYTHON_HOST=127.0.0.1
NGINX_DIR=D:\nginx-1.28.1
PAUSE_AT_END=0
