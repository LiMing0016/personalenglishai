# ==================================================
# Runtime
# ==================================================
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=18080

# ==================================================
# Database
# ==================================================
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/personal_english_ai?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_db_password_here

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=personal_english_ai
DB_USER=root
DB_PASSWORD=your_db_password_here

# ==================================================
# Auth
# ==================================================
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_strong_random_secret_64_hex_chars
JWT_ACCESS_TOKEN_SECONDS=1800
JWT_REFRESH_TOKEN_SECONDS=259200

# ==================================================
# OpenAI
# ==================================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com
# Required by the Agent Builder / ChatKit writing coach panel.
OPENAI_CHATKIT_WORKFLOW_ID=wf_your_agent_builder_workflow_id

OPENAI_PROXY_ENABLED=false
OPENAI_PROXY_URL=http://127.0.0.1:59527
OPENAI_PROXY_HOST=127.0.0.1
OPENAI_PROXY_PORT=59527

# ==================================================
# Oxford Dictionaries
# ==================================================
OXFORD_APP_ID=your_oxford_app_id_here
OXFORD_APP_KEY=your_oxford_app_key_here
OXFORD_BASE_URL=https://od-api-sandbox.oxforddictionaries.com/api/v2
OXFORD_LANGUAGE=en-gb
OXFORD_TIMEOUT_MS=8000

# ==================================================
# OCR Provider
# ==================================================
# tesseract: default local OCR fallback.
# paddle: use the PaddleOCR HTTP service for scanned PDF/image documents.
APP_OCR_PROVIDER=paddle
APP_OCR_PADDLE_ENABLED=true
APP_OCR_PADDLE_BASE_URL=http://127.0.0.1:8090
APP_OCR_PADDLE_ENDPOINT=/ocr/pdf
APP_OCR_PADDLE_LANGUAGE=ch,eng
APP_OCR_PADDLE_TIMEOUT_MS=120000
APP_OCR_PADDLE_PARSE_MODE=high_quality
APP_OCR_PADDLE_MAX_PAGES=500
APP_OCR_PADDLE_DPI=220
APP_OCR_PADDLE_ENABLE_LAYOUT=true
APP_OCR_PADDLE_ENABLE_TABLE=true
APP_OCR_PADDLE_ENABLE_FORMULA=false
APP_OCR_PADDLE_ENABLE_ORIENTATION=true
APP_OCR_PADDLE_ENABLE_UNWARPING=true

# ==================================================
# Prompt & AI Config
# ==================================================
AI_PROMPT_DEBUG=true
AI_PROMPT_LOG_RAW_ENABLED=false
AI_PROMPT_LOG_RAW_MAX_CHARS=12000
AI_PROMPT_CONTEXT_SELECTED_TEXT_MAX=1200
AI_PROMPT_CONTEXT_RECENT_EACH_MAX=200
AI_PROMPT_CONTEXT_RECENT_TURNS=8
AI_PROMPT_CONTEXT_DRAFT_MAX=1600

AI_CONTEXT_CONVERSATION_PROCESSOR=hybrid
AI_CONTEXT_CONVERSATION_PYTHON_ENABLED=true
AI_CONTEXT_CONVERSATION_PYTHON_BASE_URL=http://127.0.0.1:8001
AI_CONTEXT_CONVERSATION_PYTHON_TIMEOUT_MS=800
AI_CONTEXT_CONVERSATION_PYTHON_FALLBACK_ENABLED=true

AI_REPAIR_ENABLED=false

AI_ENDPOINT_MODE=responses
AI_MODEL=gpt-4o-mini
AI_FALLBACK_MODEL=gpt-4o-mini

# ==================================================
# Mail (SMTP)
# ==================================================
# Local development can keep MAIL_ENABLED=false; verification emails are printed to backend logs.
# Production must set MAIL_ENABLED=true and configure one SMTP option below.
MAIL_ENABLED=false

# Option A: Alibaba Cloud DirectMail SMTP
MAIL_HOST=smtpdm.aliyun.com
MAIL_PORT=465
MAIL_USERNAME=your_directmail_smtp_account
MAIL_PASSWORD=your_directmail_smtp_password
MAIL_FROM=noreply@personalenglishai.com
MAIL_SSL_ENABLE=true
MAIL_STARTTLS_ENABLE=false

# Option B: Alibaba Mail / Enterprise Mail SMTP
# MAIL_HOST=smtp.qiye.aliyun.com
# MAIL_PORT=465
# MAIL_USERNAME=noreply@personalenglishai.com
# MAIL_PASSWORD=your_alibaba_mail_client_password
# MAIL_FROM=noreply@personalenglishai.com
# MAIL_SSL_ENABLE=true
# MAIL_STARTTLS_ENABLE=false

# ==================================================
# Cookie (set true in production with HTTPS)
# ==================================================
COOKIE_SECURE=false

# Frontend base URL used in email verification and password reset links.
# start-local.bat sets this automatically from local-ports.env.
# Manual Vite default: http://localhost:3000
# start-local.bat default: http://localhost:3300
# Production: https://www.personalenglishai.com
APP_BASE_URL=http://localhost:3300
