<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.personalenglishai.backend.mapper.vocabulary.UserVocabularyPreferenceMapper">

    <resultMap id="UserVocabularyPreferenceResultMap" type="com.personalenglishai.backend.entity.vocabulary.UserVocabularyPreference">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="default_template_key" property="defaultTemplateKey"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="findPreferenceByUser" resultMap="UserVocabularyPreferenceResultMap">
        SELECT id, user_id, default_template_key, created_at, updated_at
        FROM user_vocabulary_preference
        WHERE user_id = #{userId}
        LIMIT 1
    </select>

    <insert id="upsertDefaultTemplate">
        INSERT INTO user_vocabulary_preference (user_id, default_template_key)
        VALUES (#{userId}, #{templateKey})
        ON DUPLICATE KEY UPDATE
            default_template_key = VALUES(default_template_key),
            updated_at = CURRENT_TIMESTAMP
    </insert>
</mapper>
