<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.personalenglishai.backend.mapper.translation.TranslationDocumentFileMapper">

    <resultMap id="FileResultMap" type="com.personalenglishai.backend.entity.translation.TranslationDocumentFileRecord">
        <id column="id" property="id"/>
        <result column="document_id" property="documentId"/>
        <result column="file_name" property="fileName"/>
        <result column="content_type" property="contentType"/>
        <result column="file_size" property="fileSize"/>
        <result column="sha256" property="sha256"/>
        <result column="storage_provider" property="storageProvider"/>
        <result column="storage_key" property="storageKey"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <insert id="upsert" parameterType="com.personalenglishai.backend.entity.translation.TranslationDocumentFileRecord"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO translation_document_file (
            document_id,
            file_name,
            content_type,
            file_size,
            sha256,
            storage_provider,
            storage_key
        ) VALUES (
            #{documentId},
            #{fileName},
            #{contentType},
            COALESCE(#{fileSize}, 0),
            #{sha256},
            COALESCE(#{storageProvider}, 'local'),
            #{storageKey}
        )
        ON DUPLICATE KEY UPDATE
            file_name = VALUES(file_name),
            content_type = VALUES(content_type),
            file_size = VALUES(file_size),
            sha256 = VALUES(sha256),
            storage_provider = VALUES(storage_provider),
            storage_key = VALUES(storage_key),
            updated_at = CURRENT_TIMESTAMP
    </insert>

    <select id="findByDocumentId" resultMap="FileResultMap">
        SELECT *
        FROM translation_document_file
        WHERE document_id = #{documentId}
        LIMIT 1
    </select>
</mapper>
